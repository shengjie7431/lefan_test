<script>
    layui.use(['layer','jquery'], function () {
        var layer = layui.layer,
            $ = layui.jquery

        $('body').on('click','.file-del',function () {
            var filePath = $(this).attr('data-path')
            var _flag = true
            layer.confirm('确认删除？',function () {
                //提交删除的ajax请求
                if (_flag){
                    _flag = false
                    $.ajax({
                        url:"${ctx}/sftp/survey/delFileByPath",
                        data:{"filePath" : filePath},
                        success:function(res){
                            var res= JSON.parse(res)
                            console.log(res);
                            folder("");
                            layer.closeAll()
                        }
                    });

                }

            },function () {
                _flag = true
            })


        });


        $("#materialImgsDiv").on("click", ".upd-file-name", function () {
            var _this = $(this);
            var name = _this.attr("data-file-name");
            if (name.lastIndexOf(".") > -1){
                name = name.substr(0,name.lastIndexOf("."));
            }
            $("#updFileName").val(name);
            $("#updFilePath").val(_this.attr("data-file-path"));
            $('.dialogs1').show();
        })

        $('.d-btn-3').click(function () {
            $('.dialogs1').hide()
        })
        $('.d-btn-4').click(function () {
            var updFileName = $("#updFileName").val();
            if (!updFileName){
                alert("文件名称不能为空");return;
            }
            //调用后台
            $.ajax({
                url:'${ctx}/survey/case/sic/operate',
                type:"post",
                data : {"btnCode":"updFileName","fileName" : updFileName,"filePath" : $("#updFilePath").val()},
                success:function(res,param){
                    reload();
                }
            });
        })

        $("#materialImgsDiv").on("click", ".folder-upload", function () {
            var _this = $(this);
            var filePath = _this.attr("data-file-path");
            var type = _this.attr("data-file-type");
            //调用后台
            $.ajax({
                url:'${ctx}/survey/case/sic/operate',
                type:"post",
                data : {"btnCode":"folder-upload","filePath" : filePath,"type" : type},
                success:function(res,param){
                    reload();
                }
            });
        })



    })


    folder("")
    function back(){
        var curPath = replace($("#curPath").val());
        var oldPath = replace($("#oldPath").val());
        if (oldPath.replace(/\//g,"") == curPath.replace(/\//g,"")){
            return;
        }
        curPath = replace(curPath);
        console.log("curPath2",curPath);
        curPath = curPath.substring(0,curPath.lastIndexOf("/"));
        console.log("curPath3",curPath);

        $("#curPath").val(curPath)
        folder("");
    }
    function folder(path){

        var curPath = $("#curPath").val() + "/" + path;
        var url = "${ctx}/sftp/survey/getFileByPath", param = {"folderPath":curPath};


        //拼标题
        var top = true;
        var oldPath = replace($("#oldPath").val());
        curPath = replace(curPath);
        var titlePath = "";
        if (oldPath.replace(/\//g,"") != curPath.replace(/\//g,"")){
            $(".title-top").show();
            titlePath = curPath.replace(oldPath,"/");
            titlePath = (replace(titlePath) + "").replace(/\//g,"》");
            top = false;
        }else{
            $(".title-top").hide();
        }
        $("#directionFilesTitle").html("方向附件" + titlePath);

        var oldLen = $('#materialImgsDiv .fileImg').length
        $.ajax({
            url:url,
            data:param,
            success:function(res,param){
                var files = param.data.files;
                $("#curPath").val(param.data.curPath);
                var f = true
                if (f){
                    $("#materialImgsDiv").html("");
                    if(files){
                        var newFiles = []
                        for (var i = 0; i < files.length; i++) {
                            var file = files[i];
                            // 添加文件夹 及 文件
                            if (file.folder){//文件
                                newFiles.push(file)
                            } else{//文件夹
                                var type = "upload";
                                var src = '${ctx}/img/upload.png';
                                if (file.fileName.indexOf("-不下载") > -1){
                                    src = '${ctx}/img/no-upload.jpg';
                                    type = "no-upload";
                                }
                                var uploadHtml = "<div class='folder-upload' data-file-type='"+type+"'  data-file-path='"+file.filePath+"' ><img src='"+src+"' width='20' height='20' /></div>";
                                if (top){//如果是顶级则没有不下载的按钮
                                    uploadHtml = "";
                                }
                                if (oldPath.replace(/\//g,"") != curPath.replace(/\//g,"")){

                                }
                                $("#materialImgsDiv").append(
                                    "<div ondblclick='folder(\"" + file.fileName + "\")' class='file' >" +
                                    "" + uploadHtml +
                                    "<div class='folder-img'></div>" +
                                    '<div class="img-title">' +
                                    "<a class='img-title-text' title='" + file.fileName + "'> "+ file.fileName + "</a>" +
                                    "</div>"+
                                    '<div class="img-title-num">('+file.fileSize+')</div>'+
                                    '<div class="file-del" data-path="'+file.filePath+'" onclick="deleteFile("'+(i + 1)+'","'+file.filePath+'","'+null+'\",\"'+null+'")"></div>'+
                                    <%--"<span title='修改文件名称' class='upd-file-name' data-file-path='"+file.filePath+"' data-file-name='"+file.fileName+"' ><img height='25px' width='25px' src='${ctx}/img/pen.png'></span>" +--%>
                                    "</div>");
                            }
                        }

                        var filesHtml = ''
                        var fileLen = 0
                        for (var i = 0; i < newFiles.length; i++) {
                            var file = newFiles[i];
                            // 添加文件夹 及 文件
                            var _html = ""
                            if (file.folder){//文件
                                if(file.fileExt == 'rar' || file.fileExt == 'zip'){
                                    _html = "<div class='file' id='data-id-"+(i + 1)+"'  data-id='"+(i + 1)+"'>" +
                                        "       <div class='image image-rar'></div>" +
                                        "       <a class='img-title' title='" + file.fileName + "' href='"+file.filePath+"' target='_blank'> "+ file.fileName +"</a>" +
                                        "<div class='file-del' data-path='"+file.realFilePath+"'></div>"+
                                        "<span title='修改文件名称' class='upd-file-name' data-file-path='"+file.filePath+"' data-file-name='"+file.fileName+"' ><img height='25px' width='25px' src='${ctx}/img/pen.png'></span></div>"
                                }else if(file.fileExt == 'pdf'){
                                    _html = "<div class='file' id='data-id-"+(i + 1)+"'  data-id='"+(i + 1)+"'>" +
                                        "<div class='image image-pdf' onclick='onlinePreview("+file.filePath+")'></div>"+
                                        "<a class='img-title' title='" + file.fileName + "' href='"+file.filePath+"' target='_blank'> "+ file.fileName +"</a>" +
                                        "<div class='file-del' data-path='"+file.realFilePath+"'></div>"+
                                        "<span title='修改文件名称' class='upd-file-name' data-file-path='"+file.filePath+"' data-file-name='"+file.fileName+"' ><img height='25px' width='25px' src='${ctx}/img/pen.png'></span></div>"
                                }else if(file.fileExt == 'doc' || file.fileExt == 'docx'){
                                    _html = "<div class='file' id='data-id-"+(i + 1)+"'  data-id='"+(i + 1)+"'>" +
                                        "<div class='image image-word' onclick='onlinePreview("+file.filePath+")'></div>"+
                                        "<a class='img-title' title='" + file.fileName + "' href='"+file.filePath+"' target='_blank'> "+ file.fileName +"</a>" +
                                        "<div class='file-del' data-path='"+file.filePath+"'></div>"+
                                        "<span title='修改文件名称' class='upd-file-name' data-file-path='"+file.filePath+"' data-file-name='"+file.fileName+"' ><img height='25px' width='25px' src='${ctx}/img/pen.png'></span></div>"
                                }else if(file.fileExt == 'xls' || file.fileExt == 'xlsx'){
                                    _html = "<div class='file' id='data-id-"+(i + 1)+"'  data-id='"+(i + 1)+"'>" +
                                        "<div class='image image-excel' onclick='onlinePreview("+file.filePath+")'></div>"+
                                        "<a class='img-title' title='" + file.fileName + "' href='"+file.filePath+"' target='_blank'> "+ file.fileName +"</a>" +
                                        "<div class='file-del' data-path='"+file.realFilePath+"'></div>"+
                                        "<span title='修改文件名称' class='upd-file-name' data-file-path='"+file.filePath+"' data-file-name='"+file.fileName+"' ><img height='25px' width='25px' src='${ctx}/img/pen.png'></span></div>"
                                }else{
                                    fileLen ++

                                    _html = ' <div class="file fileImg">' +
                                        '<img src="'+file.filePath+'" class="image"></img>' +
                                        '<div class="img-title">' +
                                            '<div class="img-title-text">'+file.fileName+'</div>'+

                                        '</div>' +
                                        '<div class="file-del" data-path="'+file.realFilePath+'"></div>'+
                                        '<span title="修改文件名称" class="upd-file-name" data-file-path="'+file.filePath+'" data-file-name="'+file.fileName+'"><img height="25px" width="25px" src="${ctx}/img/pen.png" /></span></div>'
                                        <%--'<span title=\'修改文件名称\' class=\'upd-file-name\' data-file-path=\'"+file.filePath+"\' data-file-name=\'"+file.fileName+"\' ><img height=\'25px\' width=\'25px\' src=\'${ctx}/img/pen.png\'></span></div>'--%>
                                }
                                filesHtml += _html

                            } else{//文件夹

                            }
                        }

                        $('#materialImgsDiv').append(filesHtml)

                        if (oldLen){
                            viewer.destroy()
                        }
                        if(fileLen){
                            viewer = new Viewer(document.getElementById('materialImgsDiv'));
                        }

                    }
                }
            }
        });
    }

    function replace(str){
        // str = str.replace(/\\\\/g,"/");
        // str = str.replace(/\/\//g,"/");
        // return str;
        if (str) {
            str = str.replace(/\\/g,"/");
            if (str.indexOf("//") > -1) {
                str = str.replace(/\/\//g,"/");
                return replace(str);
            }else{
                return str;
            }
        }
        return "";
    }
</script>
