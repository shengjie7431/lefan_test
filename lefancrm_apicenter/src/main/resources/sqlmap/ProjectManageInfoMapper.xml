        <id column="id" property="id" jdbcType="BIGINT" />
        <result column="project_name" property="projectName" jdbcType="BIGINT" />
        <result column="industry_attributes" property="industryAttributes" jdbcType="VARCHAR" />
        <result column="industry_attributes_id" property="industryAttributesId" jdbcType="VARCHAR" />
        <result column="business_attributes" property="businessAttributes" jdbcType="INTEGER" />
        <result column="business_attributes_id" property="businessAttributesId" jdbcType="VARCHAR" />
        <result column="manager_id" property="managerId" jdbcType="INTEGER" />
        <result column="manager_name" property="managerName" jdbcType="INTEGER" />
        <result column="manager_state" property="managerState" jdbcType="INTEGER" />
